    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SeasonProfile"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/DayProfile"/>
