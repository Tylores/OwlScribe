<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:ns5="http://schema.org/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasVendorId">
    <rdfs:label xml:lang="en">has vendor id</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Firmware"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
    <rdfs:comment xml:lang="en">[COSEM] Unique vendor identifier assigned by the PRIME Alliance</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/MeterProperty">
    <rdfs:label xml:lang="en">Meter Property</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Property"/>
    <rdfs:comment xml:lang="en">Class to group those properties related to electric grid meters</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/ProfileGeneric">
    <rdfs:label xml:lang="en">Profile Generic</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb32"/>
    <rdfs:comment xml:lang="en">[COSEM] This class provides a generalized concept allowing to store, sort and access data groups or data series, called capture objects. Capture objects are appropriate attributes or elements of (an) attribute(s) of COSEM objects. The capture objects are collected periodically or occasionally</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasMACAddress">
    <rdfs:label xml:lang="en">has m a c address</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/NetworkInterface"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">[COSEM] Holds the MAC address</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/SetOperationDataInput">
    <rdfs:label xml:lang="en">Set Operation Data Input</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/CosemOperationInput"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb43"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb42"/>
    <rdfs:comment xml:lang="en">This class specifies that just the range of a datatype property of the instance is going to be modified</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb39">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasFridayProfile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/">
    <vann:preferredNamespaceUri>https://saref.etsi.org/saref4grid/</vann:preferredNamespaceUri>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-25</dcterms:issued>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:description xml:lang="en">This ontology extends the SAREF ontology for the smart grid domain.</dcterms:description>
    <dcterms:source rdf:resource="https://saref.etsi.org/sources/saref4grid/"/>
    <rdfs:seeAlso rdf:resource="https://www.etsi.org/deliver/etsi_ts/103400_103499/10341012/01.01.01_60/ts_10341012v010101p.pdf"/>
    <vann:preferredNamespacePrefix>s4grid</vann:preferredNamespacePrefix>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-05</dcterms:modified>
    <owl:versionIRI rdf:resource="https://saref.etsi.org/saref4grid/v2.1.1/"/>
    <dcterms:publisher rdf:resource="https://www.etsi.org/"/>
    <owl:versionInfo>v2.1.1</owl:versionInfo>
    <dcterms:license rdf:resource="https://forge.etsi.org/etsi-software-license"/>
    <dcterms:creator rdf:resource="https://www.linkedin.com/in/sergio-mario-carulli-p%C3%A9rez-7632b5217/"/>
    <dcterms:creator rdf:resource="http://w3id.org/people/mpoveda"/>
    <dcterms:creator rdf:resource="http://www.garcia-castro.com/foaf.rdf#me"/>
    <dcterms:title xml:lang="en">SAREF4GRID: an extension of SAREF for the Smart Grid domain</dcterms:title>
    <rdfs:comment>The development of the SAREF4GRID ontology has been partially funded by the IA4TES project (MIA.2021.M04.0008), funded by the Spanish Ministry of Economic Affairs and Digital Transformation and by the NextGenerationEU program</rdfs:comment>
    <owl:priorVersion rdf:resource="https://saref.etsi.org/saref4grid/v1.1.1/"/>
    <owl:imports rdf:resource="https://saref.etsi.org/core/v4.1.1/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/VoltageSagNumber">
    <rdfs:label xml:lang="en">Voltage Sag Number</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4grid/MeterProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Property of the meter indicating the number of voltage sags detected</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasDaylightSavingsBegin">
    <rdfs:label xml:lang="en">has daylight savings begin</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">[COSEM] Defines the local switch date and time when the local time starts to deviate from the normal time</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/relatedObservation">
    <rdfs:label xml:lang="en">related observation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ProfileGeneric"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/Observation"/>
    <rdfs:comment xml:lang="en">The observation that is captured by a profile generic</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/SeasonProfile">
    <rdfs:label xml:lang="en">Season Profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb33"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb39"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb38"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb34"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb41"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb40"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb37"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb36"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb35"/>
    <rdfs:comment xml:lang="en">[COSEM] This class represents a season which is defined by its starting date and a specific day profile to be executed</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/PresetAdjustingTime">
    <rdfs:label xml:lang="en">Preset Adjusting Time</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/ComplexActionOperationInput"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb29"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb31"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb30"/>
    <rdfs:comment xml:lang="en">This class represents the parameters that are needed by a clock to modify its time</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasTuesdayProfile">
    <rdfs:label xml:lang="en">has tuesday profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
    <rdfs:comment xml:lang="en">It defines the day profile valid each Tuesday of the season</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasActionValue">
    <rdfs:label xml:lang="en">has action value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SimpleActionOperationInput"/>
    <rdfs:comment xml:lang="en">It specifies the input of a method from the instance (COSEM object) of a class. The value of this property conforms to a simple type (not a structure)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasValidityIntervalStart">
    <rdfs:label xml:lang="en">has validity interval start</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/PresetAdjustingTime"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">It defines the start of a validity interval within which the new time can be activated</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/TransformerRatio">
    <rdfs:label xml:lang="en">Transformer Ratio</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4grid/MeterProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Property of the meter indicating the transformer turn ratio</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/PowerQuality">
    <rdfs:label xml:lang="en">Power Quality</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4grid/MeterProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Property of the meter indicating its power quality</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/Voltage">
    <rdfs:label xml:lang="en">Voltage</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4grid/EnergyAndPowerProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Property of the power line indicating its voltage</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb18">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasFirmwareVersion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasSaturdayProfile">
    <rdfs:label xml:lang="en">has saturday profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
    <rdfs:comment xml:lang="en">It defines the day profile valid each Saturday of the season</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb23">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/obtainInputForProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasActiveSeasonProfile">
    <rdfs:label xml:lang="en">has active season profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/ActivityCalendar"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/SeasonProfile"/>
    <rdfs:comment xml:lang="en">[COSEM] Contains a list of active season profiles. These season profiles form an active calendar</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasCalendarNameActive"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/TimeThreshold">
    <rdfs:label xml:lang="en">Time Threshold</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4grid/MeterProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Property of the meter indicating the time outside a threshold</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasValidityIntervalEnd">
    <rdfs:label xml:lang="en">has validity interval end</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/PresetAdjustingTime"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">It defines the end of a validity interval within which the new time can be activated</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasFirmwareVersion">
    <rdfs:label xml:lang="en">has firmware version</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Firmware"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">[COSEM] Textual description of the firmware version running on the device</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasClock">
    <rdfs:label xml:lang="en">has clock</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/GridMeter"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
    <rdfs:comment xml:lang="en">The clock of the meter</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://saref.etsi.org/saref4grid/hasDaylightSavingsDeviation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasMondayProfile">
    <rdfs:label xml:lang="en">has monday profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
    <rdfs:comment xml:lang="en">It defines the day profile valid each Monday of the season</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasSpecialDayDate">
    <rdfs:label xml:lang="en">has special day date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SpecialDayProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">Dates at which a normal day is considered a special date (i.e., Christmas)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/DurationLongPowerFailure">
    <rdfs:label xml:lang="en">Duration Long Power Failure</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4grid/QualityProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Property of the power line indicating the duration of the long power failures detected</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasPresetTime">
    <rdfs:label xml:lang="en">has preset time</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/PresetAdjustingTime"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">It pre-sets the clock time to a new value</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/Script">
    <rdfs:label xml:lang="en">Script</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Function"/>
    <rdfs:comment xml:lang="en">[COSEM] Lists of actions to be executed by the meter</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/obtainToEntry">
    <rdfs:label xml:lang="en">obtain to entry</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/EntryDescriptor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedLong"/>
    <rdfs:comment xml:lang="en">It defines the last entry to be retrieved from a profile generic</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasSpecialDate">
    <rdfs:label xml:lang="en">has special date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SpecialDayEntry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">It defines the date at which a normal day is considered a special date</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/obtainFromValue">
    <rdfs:label xml:lang="en">obtain from value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/RangeDescriptor"/>
    <rdfs:comment xml:lang="en">It restricts the range of entries to be retrieved from a profile generic defining the oldest or smallest entry to retrieve</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/BreakerState">
    <rdfs:label xml:lang="en">Breaker State</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/State"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb14"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb13"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb12"/>
    <rdfs:comment xml:lang="en">[COSEM] This class manages an internal or external disconnect unit of the meter (e.g. electricity breaker, gas valve) in order to connect or disconnect – partly or entirely – the premises of the consumer to / from the supply</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/DaySchedule">
    <rdfs:label xml:lang="en">Day Scheduled</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb16"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb17"/>
    <rdfs:comment xml:lang="en">Scheduled actions to be executed at a given time for a day profile</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/GetOperationDataOutput">
