    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/SetOperationDataInput"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">It identifies the type of the attribute of an instance (COSEM object) of a class from which the data is going to be obtained. The value of this property conforms to the range of a datatype property of SAREF4GRID</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/DayProfile">
    <rdfs:label xml:lang="en">Day Profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">[COSEM] This class represents a list of scheduled actions which are defined by a script to be executed and the corresponding activation time</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/Firmware">
