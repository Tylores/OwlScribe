    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Service"/>
    <rdfs:comment xml:lang="en">This class is a representation of a set function to a network that makes the function discoverable, registerable, remotely controllable by other devices in the network</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb49">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
