    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://git.onem2m.org/MAS/BaseOntology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/RangeDescriptor">
    <rdfs:label xml:lang="en">Range Descriptor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4grid/SelectiveAccess"/>
    <rdfs:comment xml:lang="en">In the case of a get service of a profile generic class a selective access can be specified. This indicates the range of values to be retrieved from the profile generic class</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasSundayProfile">
    <rdfs:label xml:lang="en">has sunday profile</rdfs:label>
