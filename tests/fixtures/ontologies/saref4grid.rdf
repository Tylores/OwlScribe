    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
    <rdfs:comment xml:lang="en">It defines the day profile valid each Sunday of the season</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasFridayProfile">
    <rdfs:label xml:lang="en">has friday profile</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/saref4grid/hasDayProfile"/>
    <rdfs:comment xml:lang="en">It defines the day profile valid each Friday of the season</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/SetOperation">
    <rdfs:label xml:lang="en">Set Operation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb47"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Operation"/>
    <rdfs:comment xml:lang="en">This class is the means of a set service to communicate in a procedure-type manner over the network (i.e. transmit data to/from other devices). It is the –machine interpretable- exposure of a –human understandable- Command to a network</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasClockBase">
    <rdfs:label xml:lang="en">has clock base</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/Clock"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment xml:lang="en">[COSEM] Defines where the basic timing information comes from: (0) not defined, (1) internal crystal, (2) mains frequency 50 Hz, (3) mains frequency 60 Hz, (4) GPS (global positioning system), (5) radio controlled</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/Threshold">
    <rdfs:label xml:lang="en">Threshold</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4grid/MeterProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Property of the meter indicating a threshold limit</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.owl-ontologies.com/oneM2M#hasService">
    <rdfs:label xml:lang="en">has service</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://git.onem2m.org/MAS/BaseOntology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasOutputState">
    <rdfs:label xml:lang="en">has output state</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/saref4grid/BreakerState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">[COSEM] Shows the actual physical state of the device connection to the supply: (True) Connected, (False) Disconnected</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/ReactivePower">
    <rdfs:label xml:lang="en">Reactive Power</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/saref4grid/EnergyAndPowerProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">Property of the power line indicating its reactive power</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/hasInputObjectType">
    <rdfs:label xml:lang="en">has input object type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">It identifies the type of the attribute of an instance (COSEM object) of a class from which the data is going to be obtained. The value of this property conforms to the range of an object property of SAREF4GRID</rdfs:comment>
  </rdf:Description>
