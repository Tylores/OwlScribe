  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/SelectiveAccess">
    <rdfs:label xml:lang="en">Selective Access</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.owl-ontologies.com/oneM2M#OperationInput"/>
