    <rdfs:comment xml:lang="en">The selective access of a profile generic get service</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/saref4grid/Clock">
    <rdfs:label xml:lang="en">Clock</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb5"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb10"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb8"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb7"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb4"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb6"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb9"/>
    <rdfs:subClassOf rdf:nodeID="nd5b9cc4c4af04377b202f50ce018deecb11"/>
